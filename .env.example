# GTM Ops Copilot Configuration

# Data & Storage Paths
DATA_DIR=data
PLAYBOOKS_DIR=data/playbooks
SAMPLE_ACCOUNTS_DIR=data/sample_accounts
CHROMA_PERSIST_DIR=chroma_db

# Retrieval & Embeddings
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5

# LLM Configuration (Google Gemini Free Tier - get your key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.0-flash

# Web Scraping Configuration
WEB_FETCH_TIMEOUT_SECONDS=10.0
MAX_WEB_CONTENT_CHARS=8000
