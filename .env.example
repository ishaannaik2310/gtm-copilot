# ============================================================
# GTM Ops Copilot — Environment Configuration
# ============================================================
# Copy this file to .env for local development.
# All variables marked [RAILWAY] must be set in Railway's
# environment variable dashboard for production deployments.

# ------------------------------------------------------------
# LLM Configuration (Required)
# Get a free key at https://aistudio.google.com/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=                          # [RAILWAY] Required — your Google Gemini API key
DEFAULT_GEMINI_MODEL=gemini-2.0-flash    # [RAILWAY] Optional — defaults to gemini-2.0-flash

# ------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------
# Railway injects PORT automatically. Do not set this locally
# unless you want to override the default (8000).
PORT=8000

# CORS — comma-separated list of allowed frontend origins.
# Default: http://localhost:3000 (local dev only).
# [RAILWAY] Set this to your deployed frontend URL, e.g.:
#   ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# Data & Storage Paths (local dev only — Railway uses ephemeral FS)
# ------------------------------------------------------------
DATA_DIR=data
PLAYBOOKS_DIR=data/playbooks
SAMPLE_ACCOUNTS_DIR=data/sample_accounts

# Note: ChromaDB uses an in-memory EphemeralClient in production
# (rebuilt from sample data on every startup via the lifespan handler).
# CHROMA_PERSIST_DIR is not used in the deployed API.
CHROMA_PERSIST_DIR=chroma_db

# ------------------------------------------------------------
# Retrieval & Embeddings
# ------------------------------------------------------------
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5

# ------------------------------------------------------------
# Web Scraping
# ------------------------------------------------------------
WEB_FETCH_TIMEOUT_SECONDS=10.0
MAX_WEB_CONTENT_CHARS=8000
